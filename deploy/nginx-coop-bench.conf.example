# Final HTTPS site after ACME certificate issuance. Included from nginx http {}.
# Replace every boardgames.example.com. Keep existing nginx sites unchanged.
# Public clients connect directly; do not enable real_ip_header from untrusted peers.
limit_req_zone $binary_remote_addr zone=coop_requests:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=coop_connections:10m;
log_format coop_security escape=json '{"time":"$time_iso8601","remote":"$remote_addr","status":$status,"bytes":$body_bytes_sent,"duration":$request_time}';

server {
    listen 80;
    listen [::]:80;
    server_name boardgames.example.com;
    if ($host != boardgames.example.com) { return 421; }
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://boardgames.example.com$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name boardgames.example.com;
    if ($host != boardgames.example.com) { return 421; }
    if ($ssl_server_name != boardgames.example.com) { return 421; }
    ssl_certificate /etc/letsencrypt/live/boardgames.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/boardgames.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:coop_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    server_tokens off;
    client_max_body_size 64k;
    client_body_timeout 15s;
    client_header_timeout 5s;
    keepalive_timeout 30s;
    send_timeout 30s;
    large_client_header_buffers 2 8k;
    limit_conn coop_connections 20;
    limit_conn_status 429;
    limit_req_status 429;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    access_log /var/log/nginx/coop-bench.access.log coop_security;
    error_log /var/log/nginx/coop-bench.error.log warn;

    location / {
        limit_req zone=coop_requests burst=30 nodelay;
        proxy_pass http://127.0.0.1:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Tailscale-User-Login "";
        proxy_connect_timeout 2s;
        proxy_send_timeout 15s;
        proxy_read_timeout 30s;
        proxy_request_buffering on;
        proxy_buffering on;
        proxy_max_temp_file_size 0;
    }
}
