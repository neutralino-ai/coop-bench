# Replace this exact lower-case HTTPS DNS name before starting the service.
# This file contains no credentials. systemd reads it; protect it as root:root 0600.
NODE_ENV=production
PORT=8788
COOP_DATA_DIR=/var/lib/coop-bench
COOP_USERS_FILE=/etc/coop-bench/access-users.json
COOP_TRUSTED_PROXY_ORIGIN=https://boardgames.example.com
# Independent private model-message budgets; existing records never expire.
COOP_MAX_MESSAGE_BYTES=49152
COOP_MAX_MESSAGES_PER_SEAT=10000
COOP_MAX_MESSAGE_STORAGE_BYTES=1073741824
