# Template for a dedicated host; merge deliberately if Caddy already serves sites.
# Replace the hostname below AND COOP_TRUSTED_PROXY_ORIGIN with the same real name.
{
    admin 127.0.0.1:2019
    servers {
        strict_sni_host on
        protocols h1 h2
        max_header_size 16KB
        timeouts {
            read_header 5s
            read_body 15s
            write 30s
            idle 30s
        }
    }
}

boardgames.example.com {
    header {
        -Server
        Strict-Transport-Security "max-age=86400"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }
    request_body {
        max_size 64KiB
    }
    log {
        output file /var/log/caddy/coop-bench-access.jsonl {
            mode 0600
            roll_size 10MiB
            roll_keep 3
            roll_keep_for 336h
        }
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri delete
                resp_headers delete
            }
        }
    }
    reverse_proxy 127.0.0.1:8788 {
        # Preserve the real Host; the application validates the configured origin.
        # Forwarded headers never grant application permissions.
        header_up -Forwarded
        header_up -Tailscale-User-Login
        header_up -Tailscale-User-Name
        header_up -Tailscale-User-Profile-Pic
        transport http {
            dial_timeout 2s
            response_header_timeout 20s
            max_conns_per_host 64
        }
    }
}
