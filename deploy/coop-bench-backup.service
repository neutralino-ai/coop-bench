[Unit]
Description=Consistent backup of Coop Bench trajectories and agent artifacts
After=coop-bench.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/coop-bench-node/bin/node /opt/coop-bench/current/app/scripts/backup-server.mjs /var/lib/coop-bench/episodes.sqlite /var/backups/coop-bench
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/coop-bench /var/backups/coop-bench
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=512M
TimeoutStartSec=2h

