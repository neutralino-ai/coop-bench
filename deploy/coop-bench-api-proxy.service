[Unit]
Description=Coop Bench HTTPS API on 34935 and ACME challenge only on 80
After=network.target coop-bench.service
Wants=coop-bench.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
RuntimeDirectory=coop-bench-api-proxy
RuntimeDirectoryMode=0755
ExecStartPre=/usr/sbin/nginx -t -c /etc/coop-bench/api-proxy.conf
ExecStart=/usr/sbin/nginx -c /etc/coop-bench/api-proxy.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -t -c /etc/coop-bench/api-proxy.conf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGQUIT
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_KILL
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/run/coop-bench-api-proxy
MemoryMax=256M
TasksMax=32
LimitNOFILE=2048
UMask=0027
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coop-bench-api-proxy
LogRateLimitIntervalSec=30s
LogRateLimitBurst=300

[Install]
WantedBy=multi-user.target
