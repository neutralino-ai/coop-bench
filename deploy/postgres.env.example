# Private values: do not commit your populated environment file.
COOP_DATABASE_URL=postgresql://coop:replace-with-private-db-password@127.0.0.1:5432/coop
COOP_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
PORT=8788
# The API binds 127.0.0.1. A trusted HTTPS reverse proxy may forward locally.
# COOP_TRUSTED_PROXY_ORIGIN=https://coop.example.org
# Optional bootstrap-only users file. Later revocation uses postgres-users.mjs.
# COOP_USERS_FILE=/private/path/access-users.json
