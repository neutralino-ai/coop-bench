# Private production values belong in /etc/coop-bench-v09/server.env, root:root 0600.
NODE_ENV=production
PORT=8789
COOP_DATABASE_URL=postgresql://coop_bench_v09:replace-private-password@127.0.0.1:5432/coop_bench_v09
COOP_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
# The proxy validates public :34936, then supplies this fixed portless Host.
COOP_TRUSTED_PROXY_ORIGIN=https://coop.neutrinophysics.cn
# Bootstrap-only snapshot, independent from the legacy service's live file.
COOP_USERS_FILE=/etc/coop-bench-v09/access-users.json
