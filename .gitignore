# Dependencies, generated output, local runs, captured human/agent data.
node_modules/
.tools/
.pnpm-store/
runtime/
release/
dist/
data/
artifacts/
tmp/
temp/
coverage/
.cache/
.codex/
.agents/

# Downloaded publisher PDFs/images, OCR/full rulebook text and research caches
# stay local. Keep our source URLs and small structured scenario metadata.
sources/**
!sources/**/
!sources/**/*.json
!sources/README.md

# Secrets and machine-specific state, including outside the ignored folders.
.env
.env.*
*.env
*.env.*
env.txt
env-*.txt
env_*.txt
.npmrc
.netrc
*.pem
*.key
*.pfx
*.p12
*.ppk
id_rsa*
id_ed25519*
*credentials*.json
*credentials*.txt
secrets.*
token
token.*
tokens.*
*-token
*-token.*
owner.txt
tester*.txt
seat.json
users.json
access.json
connection.json
remote-connection.json
instance.lock
*.sqlite*
*.db
*.db-*
*.log
*.bak
*.tmp
*.dmp

# Explicit sample files are safe to review and commit; never real values.
!.env.example
!**/*.env.example
!**/*.credentials.example.json

# Local installers/archives and editor/OS metadata.
*.exe
*.dmg
*.app/
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
